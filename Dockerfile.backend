FROM node:20-bookworm

WORKDIR /app

# Headless Chrome + Python interpreter config.
# These are baked-in defaults. Render env vars override them at runtime,
# so do NOT set PYTHON_BIN / CHROME_BIN / CHROMEDRIVER_PATH to different
# values in the Render dashboard.
ENV NODE_ENV=production \
    SELENIUM_HEADLESS=true \
    VERIFY_HEADLESS=true \
    CHROME_BIN=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver \
    PYTHON_BIN=/opt/venv/bin/python \
    PATH=/opt/venv/bin:$PATH

# Python, Chromium, ChromeDriver and the shared libraries headless Chrome needs.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    chromium \
    chromium-driver \
    fonts-liberation \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxss1 \
    libgtk-3-0 \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Python dependencies into a virtualenv (Debian blocks system-wide pip installs).
COPY requirements.txt ./requirements.txt
RUN python3 -m venv /opt/venv \
  && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
  && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Backend source. [Bb]ackend matches either 'Backend' or 'backend' so the build
# works no matter how the folder was committed to git.
COPY [Bb]ackend/package.json [Bb]ackend/package-lock.json ./backend/
RUN cd backend && npm ci --omit=dev

COPY [Bb]ackend ./backend
COPY final_cd.py verify_flipkart_login.py ./

RUN mkdir -p /app/uploads /app/reports

WORKDIR /app/backend

CMD ["npm", "start"]
